<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom, #e8eaf6, #c5cae9);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ad.gestordatos.controller.MainController">

    <!-- Contenido central: Pantalla de bienvenida -->
    <center>
        <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
            </padding>

            <!-- Titulo principal -->
            <Label text="Loan Management" style="-fx-text-fill: #1a237e;">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>

            <!-- Subtitulo -->
            <Label text="Select an option to begin" style="-fx-text-fill: #5c6bc0; -fx-font-size: 14px;" />

            <Separator prefWidth="400.0" maxWidth="400.0" style="-fx-background-color: #7986cb;" />

            <!-- Botones principales -->
            <HBox alignment="CENTER" spacing="40.0">
                <padding>
                    <Insets top="20.0" />
                </padding>

                <!-- Boton Crear Socio -->
                <VBox alignment="CENTER" spacing="12.0" prefWidth="190.0" prefHeight="190.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25 20 25 20; -fx-cursor: hand;" onMouseClicked="#showSocios">
                    <effect>
                        <DropShadow color="#00000033" radius="15.0" offsetY="4.0" />
                    </effect>
                    <Label text="PARTNERS" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <Button onAction="#showSocios" text="Create Partner" prefWidth="150.0" prefHeight="45.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" />
                    <Label text="Register new partner" style="-fx-text-fill: #757575; -fx-font-size: 12px;" />
                </VBox>

                <!-- Boton Prestamos -->
                <VBox alignment="CENTER" spacing="12.0" prefWidth="190.0" prefHeight="190.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25 20 25 20; -fx-cursor: hand;" onMouseClicked="#showPrestamos">
                    <effect>
                        <DropShadow color="#00000033" radius="15.0" offsetY="4.0" />
                    </effect>
                    <Label text="LOANS" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <Button onAction="#showPrestamos" text="Loans" prefWidth="150.0" prefHeight="45.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" />
                    <Label text="Manage loans" style="-fx-text-fill: #757575; -fx-font-size: 12px;" />
                </VBox>

                <!-- Boton Lista Prestamos -->
                <VBox alignment="CENTER" spacing="12.0" prefWidth="190.0" prefHeight="190.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25 20 25 20; -fx-cursor: hand;" onMouseClicked="#showTabla">
                    <effect>
                        <DropShadow color="#00000033" radius="15.0" offsetY="4.0" />
                    </effect>
                    <Label text="LIST" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <Button onAction="#showTabla" text="Loan List" prefWidth="150.0" prefHeight="45.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" />
                    <Label text="View all loans" style="-fx-text-fill: #757575; -fx-font-size: 12px;" />
                </VBox>

            </HBox>

        </VBox>
    </center>

    <!-- Barra inferior -->
    <bottom>
        <HBox style="-fx-background-color: #303f9f; -fx-padding: 8 15 8 15;" alignment="CENTER_RIGHT" prefWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
            <Label style="-fx-font-size: 11px; -fx-text-fill: white;" text="Data Manager - Team 7" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
            <Button onAction="#showSociosTable" text="Partners" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>
    </bottom>

</BorderPane>
