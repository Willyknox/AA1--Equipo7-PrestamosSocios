<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="mainContainer" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ad.gestordatos.controller.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Gestión">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#showSocios" text="Socios" />
                  <MenuItem mnemonicParsing="false" onAction="#showPrestamos" text="Préstamos" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ver">
             <items>
                <MenuItem mnemonicParsing="false" onAction="#showTabla" text="Tabla de Datos" />
             </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
