<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ad.gestordatos.controller.TablaController">
   <top>
      <AnchorPane prefHeight="60.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Tabla de Socios">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </top>
   <center>
      <TableView fx:id="tablaSocios" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
          <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
          <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
          <TableColumn fx:id="colNacimiento" prefWidth="100.0" text="Nacimiento" />
          <TableColumn fx:id="colMasPrestamos" prefWidth="100.0" text="Más Préstamos" />
        </columns>
      </TableView>
   </center>
</BorderPane>
